{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 4,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/.turbo/**", "**/*.d.ts"],
  "overrides": [
    {
      "files": ["**/*.json", "**/*.jsonc"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["**/*.yml", "**/*.yaml"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
